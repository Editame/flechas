; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Editame Juegos"
config/description="Colección de juegos pequeños, sin anuncios ni cuentas."
run/main_scene="res://src/ui/arranque.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[autoload]

Sesion="*res://src/shared/sesion.gd"
Config="*res://src/shared/config.gd"
Audio="*res://src/shared/audio.gd"
Progreso="*res://src/shared/progreso.gd"
API_Client="*res://src/shared/api_client.gd"
PackFlechas="*res://src/games/flechas/pack.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom="res://src/ui/tema_ui.tres"

[rendering]
textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.043, 0.063, 0.125, 1)

[flechas]

mostrar_servidor=false





