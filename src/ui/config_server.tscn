[gd_scene load_steps=2 format=3 uid="uid://config_server"]

[ext_resource type="Script" path="res://src/ui/config_server.gd" id="1.config"]

[node name="VBoxContainer" type="VBoxContainer"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
