[node name="Titulo" type="Label" parent="Panel/VBox"]
layout_mode = 2
text = "Esto es Patio de Juegos"
theme_override_font_sizes/font_size = 34
theme_override_colors/font_color = Color(0.91, 0.93, 0.97, 1)

[node name="Scroll" type="ScrollContainer" parent="Panel/VBox"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Texto" type="VBoxContainer" parent="Panel/VBox/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 14

[node name="P1" type="Label" parent="Panel/VBox/Scroll/Texto"]
layout_mode = 2
text = "Esto no empezó como un negocio. Empezó porque mis hijas querían jugar y, cada poco, un anuncio les cortaba la partida."
autowrap_mode = 2
theme_override_font_sizes/font_size = 19

[node name="P2" type="Label" parent="Panel/VBox/Scroll/Texto"]
layout_mode = 2
text = "Patio de Juegos nace para ellas y para cualquiera: juegos para jugar online u offline, sin cuentas y sin los benditos anuncios, para que los niños puedan jugar tranquilos."
autowrap_mode = 2
theme_override_font_sizes/font_size = 19

[node name="P3" type="Label" parent="Panel/VBox/Scroll/Texto"]
layout_mode = 2
text = "Que sea gratis no significa que no cueste. Esto lleva tiempo y dinero, así que estoy buscando una forma justa de monetizar: colaboraciones, una caja de apoyo o, quizá, un anuncio opcional. Nunca un anuncio que te corte el juego."
autowrap_mode = 2
theme_override_font_sizes/font_size = 19

[node name="P4" type="Label" parent="Panel/VBox/Scroll/Texto"]
layout_mode = 2
text = "Esto es solo el principio. Si tienes una idea de juego —con una referencia, una imagen o un enlace— mándala por la caja de sugerencias. La leeré."
autowrap_mode = 2
theme_override_font_sizes/font_size = 19

[node name="P5" type="Label" parent="Panel/VBox/Scroll/Texto"]
layout_mode = 2
text = "Gracias por jugar."
autowrap_mode = 2
theme_override_font_sizes/font_size = 19

[node name="Destacado" type="Label" parent="Panel/VBox"]
layout_mode = 2
text = "Sin anuncios. Sin cuentas. Online u offline."
horizontal_alignment = 1
theme_override_font_sizes/font_size = 20
theme_override_colors/font_color = Color(1, 0.72, 0.01, 1)

